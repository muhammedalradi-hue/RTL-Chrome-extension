{
  "manifest_version": 3,
  "name": "RTL Toggle",
  "version": "1.3.2",
  "description": "إصلاح اتجاه ومحاذاة النص العربي في الصفحة الحالية بنقرة واحدة، مع تشغيل وإيقاف فوريين.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "تشغيل إصلاح RTL",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  }
}
