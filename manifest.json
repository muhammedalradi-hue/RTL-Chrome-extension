{
  "manifest_version": 3,
  "name": "RTL Toggle",
  "version": "1.6.0",
  "description": "إصلاح اتجاه ومحاذاة النص العربي بنقرة واحدة، والإملاء بالصوت في أي حقل كتابة، وحفظ الصفحة كما تراها في ملف PDF بحجم الصفحة.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "debugger", "downloads", "offscreen"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "تشغيل إصلاح RTL",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "commands": {
    "dictate": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "إملاء"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  }
}
