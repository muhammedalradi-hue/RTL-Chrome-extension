{
  "manifest_version": 3,
  "name": "RTL Toggle",
  "version": "1.5.0",
  "description": "إصلاح اتجاه ومحاذاة النص العربي بنقرة واحدة، مع تثبيت الإصلاح على مواقع تختارها، وحفظ الصفحة كما تراها في ملف PDF بحجم الصفحة.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "debugger", "downloads"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "تشغيل إصلاح RTL",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  }
}
